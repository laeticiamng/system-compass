#!/bin/sh
#
# Hook pre-commit Git pour vérifier les traductions
# Ce script s'exécute automatiquement avant chaque commit
#

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🔍 Vérification des patterns de traduction...${NC}"

# Exécuter le script de vérification des patterns
node scripts/check-translation-patterns.js
PATTERNS_EXIT_CODE=$?

if [ $PATTERNS_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "${RED}❌ Erreurs de patterns de traduction détectées !${NC}"
  echo "${YELLOW}Corrigez les erreurs ci-dessus avant de committer.${NC}"
  echo ""
  echo "Pour ignorer cette vérification (non recommandé):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

echo "${YELLOW}🔍 Vérification des clés de traduction...${NC}"

# Exécuter le script de vérification des clés
node scripts/check-translation-keys.js
KEYS_EXIT_CODE=$?

if [ $KEYS_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "${RED}❌ Clés de traduction manquantes détectées !${NC}"
  echo "${YELLOW}Corrigez les erreurs ci-dessus avant de committer.${NC}"
  echo ""
  echo "Pour générer les traductions manquantes:"
  echo "  node scripts/generate-missing-translations.js"
  echo ""
  echo "Pour ignorer cette vérification (non recommandé):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

echo "${GREEN}✓ Toutes les vérifications de traduction ont réussi !${NC}"
echo ""
exit 0
